@inherits LayoutComponentBase
@inject AuthService Auth

<div class="app-layout">
    <div class="top-nav">
        <span class="brand">🧭 UG Campus Navigator</span>
        <nav>
            <a href="/">Map</a>
            @if (Auth.IsAdmin)
            {
                <a href="/admin">Admin Dashboard</a>
            }
            @if (Auth.IsLoggedIn)
            {
                <a href="/admin/logout">Logout (@Auth.FullName)</a>
            }
            else
            {
                <a href="/admin/login">Admin Login</a>
            }
        </nav>
    </div>
    <div class="main-content">
        @Body
    </div>
</div>
