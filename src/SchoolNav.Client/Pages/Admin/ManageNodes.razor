@page "/admin/nodes"
@inject ApiService Api
@inject AuthService Auth
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!Auth.IsAdmin)
{
    <p style="padding:2rem;">Admins only. <a href="/admin/login">Log in</a></p>
}
else
{
    <div class="sidebar">
        <h3>Walkway Graph</h3>
        <p style="font-size:0.85rem;color:#6b7280;">
            Click the map to capture coordinates, then add a Node. Nodes are the points that paths connect —
            this is what Dijkstra routes through.
        </p>

        <div class="form-group">
            <label>Label</label>
            <input @bind="nodeLabel" placeholder="e.g. Near Balme Library" />
        </div>
        <div class="form-group">
            <label>Type</label>
            <select @bind="nodeType">
                @foreach (var t in Enum.GetValues<NodeType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Coordinates (click map)</label>
            <input value="@($"{clickedLat:F6}, {clickedLng:F6}")" readonly />
        </div>
        <button class="btn-primary" @onclick="AddNode">Add Node</button>

        <h4 style="margin-top:1.5rem;">Connect Two Nodes (Edge)</h4>
        <div class="form-group">
            <label>From Node</label>
            <select @bind="edgeFromId">
                <option value="0">-- select --</option>
                @foreach (var n in nodes)
                {
                    <option value="@n.Id">@(n.Label ?? $"Node {n.Id}")</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>To Node</label>
            <select @bind="edgeToId">
                <option value="0">-- select --</option>
                @foreach (var n in nodes)
                {
                    <option value="@n.Id">@(n.Label ?? $"Node {n.Id}")</option>
                }
            </select>
        </div>
        <button class="btn-primary" @onclick="AddEdge">Connect Nodes</button>

        @if (errorMessage is not null)
        {
            <p class="error-text">@errorMessage</p>
        }

        <p style="margin-top:1rem;font-size:0.85rem;color:#6b7280;">
            Red dots = nodes, dashed orange lines = edges (drawn on the map so you can see the current graph).
        </p>

        <h4 style="margin-top:1rem;">Edges (@edges.Count)</h4>
        <table class="admin-table">
            <tbody>
                @foreach (var e in edges)
                {
                    <tr>
                        <td style="font-size:0.85rem;">@LabelFor(e.NodeAId) → @LabelFor(e.NodeBId) (@Math.Round(e.DistanceMeters)m)</td>
                        <td><a href="#" @onclick="() => DeleteEdge(e.Id)" @onclick:preventDefault>Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 style="margin-top:1rem;">Nodes (@nodes.Count)</h4>
        <table class="admin-table">
            <tbody>
                @foreach (var n in nodes)
                {
                    <tr>
                        <td style="font-size:0.85rem;">@(n.Label ?? $"Node {n.Id}") (@n.Type)</td>
                        <td><a href="#" @onclick="() => DeleteNode(n.Id)" @onclick:preventDefault>Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="map-container">
        <div id="campus-map"></div>
    </div>
}

@code {
    private List<NodeDto> nodes = new();
    private List<EdgeDto> edges = new();
    private string nodeLabel = string.Empty;
    private NodeType nodeType = NodeType.Waypoint;
    private double clickedLat = 5.6500, clickedLng = -0.1873;
    private int edgeFromId, edgeToId;
    private string? errorMessage;
    private DotNetObjectReference<ManageNodes>? dotNetRef;

    private static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new()
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    protected override async Task OnInitializedAsync()
    {
        nodes = await Api.GetNodesAsync();
        edges = await Api.GetEdgesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("schoolNavMap.init", "campus-map", 5.6500, -0.1873, 16);
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("schoolNavMap.enableClickToPlace", dotNetRef);
            await RedrawGraph();
        }
    }

    private async Task RedrawGraph()
    {
        var nodesJson = System.Text.Json.JsonSerializer.Serialize(nodes, JsonOpts);
        var edgesJson = System.Text.Json.JsonSerializer.Serialize(edges, JsonOpts);
        await JS.InvokeVoidAsync("schoolNavMap.drawGraph", nodesJson, edgesJson);
    }

    private string LabelFor(int nodeId) =>
        nodes.FirstOrDefault(n => n.Id == nodeId)?.Label ?? $"Node {nodeId}";

    [JSInvokable]
    public void OnMapClicked(double lat, double lng)
    {
        clickedLat = lat;
        clickedLng = lng;
        StateHasChanged();
    }

    private async Task AddNode()
    {
        errorMessage = null;
        var created = await Api.CreateNodeAsync(new NodeCreateDto(clickedLat, clickedLng, nodeType, nodeLabel));
        if (created is null)
        {
            errorMessage = "Failed to add node. Make sure you're logged in as an admin.";
            return;
        }
        nodes = await Api.GetNodesAsync();
        nodeLabel = string.Empty;
        await RedrawGraph();
    }

    private async Task AddEdge()
    {
        errorMessage = null;
        if (edgeFromId == 0 || edgeToId == 0 || edgeFromId == edgeToId)
        {
            errorMessage = "Choose two different nodes to connect.";
            return;
        }
        var success = await Api.CreateEdgeAsync(new EdgeCreateDto(edgeFromId, edgeToId));
        if (!success)
        {
            errorMessage = "Failed to create edge.";
            return;
        }
        edges = await Api.GetEdgesAsync();
        await RedrawGraph();
    }

    private async Task DeleteNode(int id)
    {
        errorMessage = null;
        var (success, error) = await Api.DeleteNodeAsync(id);
        if (!success)
        {
            errorMessage = error ?? "Failed to delete node. It may still be in use by an edge or a location.";
            return;
        }
        nodes = await Api.GetNodesAsync();
        await RedrawGraph();
    }

    private async Task DeleteEdge(int id)
    {
        errorMessage = null;
        var success = await Api.DeleteEdgeAsync(id);
        if (!success)
        {
            errorMessage = "Failed to delete edge.";
            return;
        }
        edges = await Api.GetEdgesAsync();
        await RedrawGraph();
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef is not null)
        {
            await JS.InvokeVoidAsync("schoolNavMap.disableClickToPlace");
            dotNetRef.Dispose();
        }
    }
}
